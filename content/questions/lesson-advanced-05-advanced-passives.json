    {
      "id": "lq-advanced-05-advanced-passives-01",
      "part": 5,
      "difficulty": 1,
      "category": "gram-passive-voice",
      "stem": "We ___ our office repainted last month.",
      "choices": [
        "had",
        "did",
        "were",
        "made"
      ],
      "correct": 0,
      "explanation": {
        "fr": {
          "rule": "have + objet + participe passé.",
          "why_wrong": [
            "B : « did » + participe ne forme pas la causative.",
            "C : « were repainted » changerait le sujet.",
            "D : « made » + participe est incorrect ici."
          ],
          "example": "I had my hair cut."
        },
        "en": {
          "rule": "have + object + past participle.",
          "why_wrong": [
            "B: 'did' + participle does not form the causative.",
            "C: 'were repainted' would change the subject.",
            "D: 'made' + participle is incorrect here."
          ],
          "example": "I had my hair cut."
        }
      },
      "vocab": []
    },
    {
      "id": "lq-advanced-05-advanced-passives-02",
      "part": 5,
      "difficulty": 3,
      "category": "gram-passive-voice",
      "stem": "The company is said ___ planning a major expansion.",
      "choices": [
        "being",
        "it is",
        "that is",
        "to be"
      ],
      "correct": 3,
      "explanation": {
        "fr": {
          "rule": "be said to + infinitif.",
          "why_wrong": [
            "A : Après « is said » : infinitif.",
            "B : Structure incorrecte avec un sujet déjà exprimé.",
            "C : « said that is » est incorrect : « said that it is »."
          ],
          "example": "He is believed to be abroad."
        },
        "en": {
          "rule": "be said to + infinitive.",
          "why_wrong": [
            "A: After 'is said': infinitive.",
            "B: Incorrect structure with an expressed subject.",
            "C: 'said that is' is incorrect: 'said that it is'."
          ],
          "example": "He is believed to be abroad."
        }
      },
      "vocab": []
    },
