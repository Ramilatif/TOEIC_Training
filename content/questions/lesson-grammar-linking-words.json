    },
    {
      "id": "lq-grammar-linking-words-05",
      "part": 5,
      "difficulty": 3,
      "category": "gram-conjunctions",
      "stem": "Which sentence is correct?",
      "choices": [
        "The report was late; however the client accepted it.",
        "The report was late however the client accepted it.",
        "The report was late; however, the client accepted it.",
        "The report was late, however the client accepted it."
      ],
      "correct": 2,
      "explanation": {
        "fr": {
          "rule": "; however, = ponctuation correcte.",
          "why_wrong": [
            "A : Il manque la virgule après « however ».",
            "B : Pas de ponctuation : « however » ne relie pas deux propositions comme une conjonction.",
            "D : Une virgule seule ne suffit pas (virgule fautive)."
          ],
          "example": "I tried; however, I failed."
        },
        "en": {
          "rule": "; however, = correct punctuation.",
          "why_wrong": [
            "A: The comma after 'however' is missing.",
            "B: No punctuation: 'however' does not join clauses like a conjunction.",
            "D: A comma alone is not enough (comma splice)."
          ],
          "example": "I tried; however, I failed."
        }
      },
      "vocab": []
    },
    {
