            "D : « Sinon » : mauvais sens."
          ],
          "example": "Subsequently, she resigned."
        },
        "en": {
          "rule": "Subsequently / then = next.",
          "why_wrong": [
            "B: Example: wrong meaning.",
            "C: Contrast: wrong meaning.",
            "D: 'Or else': wrong meaning."
          ],
          "example": "Subsequently, she resigned."
        }
      },
      "vocab": []
    },
    {
