  "questions": [
    {
      "id": "lq-grammar-linking-words-01",
      "part": 5,
      "difficulty": 1,
      "category": "gram-conjunctions",
      "stem": "The software is expensive. ___, it saves a great deal of time.",
      "choices": [
        "However",
        "Therefore",
        "Moreover",
        "Otherwise"
      ],
      "correct": 0,
      "explanation": {
        "fr": {
          "rule": "However = opposition entre deux phrases.",
          "why_wrong": [
            "B : Exprime une conséquence ; ici il y a une opposition.",
            "C : Ajoute un argument de même sens ; ici le sens s'oppose.",
            "D : Signifie « sinon » : ne convient pas."
          ],
          "example": "It is old. However, it works."
        },
        "en": {
          "rule": "However = contrast between two sentences.",
          "why_wrong": [
            "B: Expresses result; here there is contrast.",
            "C: Adds a same-direction point; here the sense is opposed.",
            "D: Means 'or else': does not fit."
          ],
          "example": "It is old. However, it works."
        }
      },
      "vocab": []
    },
    {
      "id": "lq-grammar-linking-words-02",
      "part": 5,
      "difficulty": 2,
      "category": "gram-conjunctions",
      "stem": "Our sales doubled this year. ___, we plan to hire more staff.",
      "choices": [
        "Otherwise",
        "Consequently",
        "Instead",
        "Nevertheless"
      ],
      "correct": 1,
      "explanation": {
        "fr": {
          "rule": "Consequently = conséquence.",
          "why_wrong": [
            "A : « Sinon » : mauvais sens.",
            "C : Remplacement : mauvais sens.",
            "D : Opposition : ne suit pas logiquement."
          ],
          "example": "It rained; consequently, we stayed."
        },
        "en": {
          "rule": "Consequently = result.",
          "why_wrong": [
            "A: 'Or else': wrong meaning.",
            "C: Replacement: wrong meaning.",
            "D: Contrast: does not follow logically."
          ],
          "example": "It rained; consequently, we stayed."
        }
      },
      "vocab": []
    },
    {
      "id": "lq-grammar-linking-words-03",
      "part": 5,
      "difficulty": 1,
      "category": "gram-conjunctions",
      "stem": "Please confirm by Friday; ___, your reservation will be cancelled.",
      "choices": [
        "moreover",
        "therefore",
        "meanwhile",
        "otherwise"
      ],
      "correct": 3,
      "explanation": {
        "fr": {
          "rule": "Otherwise = sinon, conséquence négative.",
          "why_wrong": [
            "A : Addition : mauvais sens.",
            "B : Conséquence positive : mauvais sens.",
            "C : Simultanéité : mauvais sens."
          ],
          "example": "Hurry; otherwise you will miss it."
        },
        "en": {
          "rule": "Otherwise = or else.",
          "why_wrong": [
            "A: Addition: wrong meaning.",
            "B: Positive result: wrong meaning.",
            "C: Simultaneity: wrong meaning."
          ],
          "example": "Hurry; otherwise you will miss it."
        }
      },
      "vocab": []
    },
    {
      "id": "lq-grammar-linking-words-04",
      "part": 5,
      "difficulty": 1,
      "category": "gram-conjunctions",
      "stem": "The design is elegant. ___, it is very affordable.",
      "choices": [
        "Instead",
        "Otherwise",
        "However",
        "Moreover"
      ],
      "correct": 3,
      "explanation": {
        "fr": {
          "rule": "Moreover = addition.",
          "why_wrong": [
            "A : Remplacement : mauvais sens.",
            "B : « Sinon » : mauvais sens.",
            "C : Opposition : l'idée s'ajoute, elle ne s'oppose pas."
          ],
          "example": "It is fast; moreover, it is quiet."
        },
        "en": {
          "rule": "Moreover = addition.",
          "why_wrong": [
            "A: Replacement: wrong meaning.",
            "B: 'Or else': wrong meaning.",
            "C: Contrast: the idea adds, it does not oppose."
          ],
          "example": "It is fast; moreover, it is quiet."
        }
      },
