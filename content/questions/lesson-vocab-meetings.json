        "minutes",
        "presentation"
      ],
      "correct": 2,
      "explanation": {
        "fr": {
          "rule": "Take the minutes = rédiger le compte rendu.",
          "why_wrong": [
            "A : liste des sujets, pas un compte rendu.",
            "B : nombre minimum de participants.",
            "D : exposé."
          ],
          "example": "Please take the minutes."
        },
        "en": {
          "rule": "Take the minutes = write the record.",
          "why_wrong": [
            "A: list of topics, not a record.",
            "B: minimum attendance.",
            "D: talk."
          ],
          "example": "Please take the minutes."
        }
      },
