      "part": 5,
      "difficulty": 2,
      "category": "voc-general",
      "stem": "The new tax policy will directly ___ small businesses.",
      "choices": [
        "affect",
        "effect",
        "affection",
        "effects"
      ],
      "correct": 0,
      "explanation": {
        "fr": {
          "rule": "affect = verbe (influencer).",
          "why_wrong": [
            "B : Nom : un verbe est attendu après « will ».",
            "C : = affection.",
            "D : Nom au pluriel."
          ],
          "example": "It affects us."
        },
        "en": {
          "rule": "affect = verb (to influence).",
          "why_wrong": [
            "B: Noun: a verb is expected after 'will'.",
            "C: = fondness.",
            "D: Plural noun."
          ],
          "example": "It affects us."
        }
      },
      "vocab": []
    },
