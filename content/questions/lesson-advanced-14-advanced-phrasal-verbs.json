        "phase out"
      ],
      "correct": 3,
      "explanation": {
        "fr": {
          "rule": "phase out = supprimer progressivement.",
          "why_wrong": [
            "A : = introduire progressivement : sens contraire.",
            "B : = prendre du retard.",
            "C : = reporter."
          ],
          "example": "phase out a product"
        },
        "en": {
          "rule": "phase out = stop gradually.",
          "why_wrong": [
            "A: = introduce gradually: opposite meaning.",
            "B: = lag.",
            "C: = move to the next period."
          ],
          "example": "phase out a product"
        }
