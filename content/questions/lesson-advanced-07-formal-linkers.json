  "questions": [
    {
      "id": "lq-advanced-07-formal-linkers-01",
      "part": 5,
      "difficulty": 3,
      "category": "gram-conjunctions",
      "stem": "___ the unexpected delay, the project was completed on schedule.",
      "choices": [
        "Hence",
        "Whereas",
        "Notwithstanding",
        "Albeit"
      ],
      "correct": 2,
      "explanation": {
        "fr": {
          "rule": "Notwithstanding + nom = malgré.",
          "why_wrong": [
            "A : « Hence » exprime la conséquence.",
            "B : « Whereas » est suivi d'une proposition.",
            "D : « Albeit » s'emploie avec un adjectif ou un groupe court."
          ],
          "example": "Notwithstanding the rain, we left."
        },
        "en": {
          "rule": "Notwithstanding + noun = despite.",
          "why_wrong": [
            "A: 'Hence' expresses result.",
            "B: 'Whereas' is followed by a clause.",
            "D: 'Albeit' is used with an adjective or short phrase."
          ],
          "example": "Notwithstanding the rain, we left."
        }
      },
      "vocab": []
    },
    {
      "id": "lq-advanced-07-formal-linkers-02",
      "part": 5,
      "difficulty": 2,
      "category": "gram-conjunctions",
      "stem": "Sales in Asia rose by 10 percent, ___ sales in Europe fell by 5 percent.",
      "choices": [
        "hence",
        "provided",
        "therefore",
        "whereas"
      ],
      "correct": 3,
      "explanation": {
        "fr": {
          "rule": "whereas = alors que (contraste).",
          "why_wrong": [
            "A : Exprime la conséquence, pas le contraste.",
            "B : Exprime la condition.",
            "C : Exprime la conséquence, pas le contraste."
          ],
          "example": "He is rich, whereas she is poor."
        },
        "en": {
          "rule": "whereas = while (contrast).",
          "why_wrong": [
            "A: Expresses result, not contrast.",
            "B: Expresses condition.",
            "C: Expresses result, not contrast."
          ],
          "example": "He is rich, whereas she is poor."
        }
      },
      "vocab": []
    },
    {
      "id": "lq-advanced-07-formal-linkers-03",
      "part": 5,
      "difficulty": 3,
      "category": "gram-conjunctions",
      "stem": "The company cut its energy costs, ___ increasing its annual profit.",
      "choices": [
        "however",
        "unless",
        "thereby",
        "therefore"
      ],
      "correct": 2,
      "explanation": {
        "fr": {
          "rule": "thereby + -ing = ce faisant.",
          "why_wrong": [
            "A : Opposition : sens faux.",
            "B : Condition : sens faux.",
            "D : « therefore » ne se combine pas avec « increasing »."
          ],
          "example": "He quit, thereby ending debate."
        },
        "en": {
          "rule": "thereby + -ing = by doing so.",
          "why_wrong": [
            "A: Contrast: wrong meaning.",
            "B: Condition: wrong meaning.",
            "D: 'therefore' does not combine with 'increasing'."
          ],
          "example": "He quit, thereby ending debate."
        }
      },
      "vocab": []
    },
    {
      "id": "lq-advanced-07-formal-linkers-04",
      "part": 5,
      "difficulty": 2,
      "category": "gram-conjunctions",
      "stem": "Despite ___ late, the delegates were welcomed warmly.",
      "choices": [
        "to arrive",
        "arrived",
        "arriving",
        "they arrived"
      ],
      "correct": 2,
      "explanation": {
        "fr": {
          "rule": "Despite + -ing / nom.",
          "why_wrong": [
            "A : Infinitif : incorrect après « despite ».",
            "B : Participe passé : incorrect.",
            "D : « Despite » est suivi d'un nom ou d'un -ing, pas d'une proposition."
          ],
          "example": "Despite being tired…"
        },
        "en": {
          "rule": "Despite + -ing / noun.",
          "why_wrong": [
            "A: Infinitive: incorrect after 'despite'.",
            "B: Past participle: incorrect.",
            "D: 'Despite' is followed by a noun or -ing, not a clause."
          ],
          "example": "Despite being tired…"
        }
      },
      "vocab": []
    },
    {
