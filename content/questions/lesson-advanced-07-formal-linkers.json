    {
      "id": "lq-advanced-07-formal-linkers-07",
      "part": 5,
      "difficulty": 2,
      "category": "gram-conjunctions",
      "stem": "Which sentence is correct?",
      "choices": [
        "Owing to that the strike, all flights were cancelled.",
        "Owing to the strike, all flights were cancelled.",
        "Owing to the strike were happening, all flights were cancelled.",
        "Owing the strike, all flights were cancelled."
      ],
      "correct": 1,
      "explanation": {
        "fr": {
          "rule": "Owing to + nom.",
          "why_wrong": [
            "A : Construction incorrecte.",
            "C : « Owing to » est suivi d'un nom.",
            "D : Il manque « to »."
          ],
          "example": "Owing to rain, we left."
        },
        "en": {
          "rule": "Owing to + noun.",
          "why_wrong": [
            "A: Incorrect construction.",
            "C: 'Owing to' is followed by a noun.",
            "D: 'to' is missing."
          ],
          "example": "Owing to rain, we left."
        }
      },
      "vocab": []
    },
    {
