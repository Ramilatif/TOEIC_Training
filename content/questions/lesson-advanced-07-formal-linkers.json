    },
    {
      "id": "lq-advanced-07-formal-linkers-06",
      "part": 5,
      "difficulty": 3,
      "category": "gram-conjunctions",
      "stem": "The scheme is a useful, ___ limited, solution to the problem.",
      "choices": [
        "although",
        "albeit",
        "whereas",
        "despite"
      ],
      "correct": 1,
      "explanation": {
        "fr": {
          "rule": "albeit + adjectif = quoique.",
          "why_wrong": [
            "A : « although » est suivi d'une proposition.",
            "C : Contraste entre propositions.",
            "D : Préposition : incorrect devant un adjectif ici."
          ],
          "example": "A cheap, albeit slow, service."
        },
        "en": {
          "rule": "albeit + adjective = although it is.",
          "why_wrong": [
            "A: 'although' is followed by a clause.",
            "C: Contrast between clauses.",
            "D: Preposition: incorrect before an adjective here."
          ],
          "example": "A cheap, albeit slow, service."
        }
      },
