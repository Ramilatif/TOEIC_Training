      "difficulty": 2,
      "category": "gram-modals",
      "stem": "The lights are on in his office; he ___ still be working.",
      "choices": [
        "should have",
        "must",
        "would",
        "needn't"
      ],
      "correct": 1,
      "explanation": {
        "fr": {
          "rule": "must = quasi certain.",
          "why_wrong": [
            "A : Reproche, pas déduction présente.",
            "C : Conditionnel : pas de déduction ici.",
            "D : Ne convient pas pour une déduction."
          ],
          "example": "He must be tired."
        },
        "en": {
          "rule": "must = almost certain.",
          "why_wrong": [
            "A: Criticism, not present deduction.",
            "C: Conditional: no deduction here.",
            "D: Does not fit a deduction."
          ],
          "example": "He must be tired."
        }
      },
      "vocab": []
    },
