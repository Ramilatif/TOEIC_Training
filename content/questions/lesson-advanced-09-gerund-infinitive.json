    {
      "id": "lq-advanced-09-gerund-infinitive-01",
      "part": 5,
      "difficulty": 3,
      "category": "gram-gerund-infinitive",
      "stem": "I clearly remember ___ the contract last Tuesday.",
      "choices": [
        "to sign",
        "sign",
        "having to sign",
        "signing"
      ],
      "correct": 3,
      "explanation": {
        "fr": {
          "rule": "remember + -ing = se rappeler avoir fait.",
          "why_wrong": [
            "A : « remember to » = penser à faire (futur) ; ici le souvenir est passé.",
            "B : Base verbale : incorrect.",
            "C : Sens différent."
          ],
          "example": "I remember meeting her."
        },
        "en": {
          "rule": "remember + -ing = recall having done.",
          "why_wrong": [
            "A: 'remember to' = not forget to do (future); here the memory is past.",
            "B: Base form: incorrect.",
            "C: Different meaning."
          ],
          "example": "I remember meeting her."
        }
      },
      "vocab": []
    },
