    {
      "id": "lq-vocab-false-friends-01",
      "part": 5,
      "difficulty": 1,
      "category": "voc-general",
      "stem": "The CEO is ___ on a business trip and will return on Monday.",
      "choices": [
        "eventually",
        "actually",
        "possibly",
        "currently"
      ],
      "correct": 3,
      "explanation": {
        "fr": {
          "rule": "currently = actuellement.",
          "why_wrong": [
            "A : Signifie « finalement ».",
            "B : Signifie « en fait », pas « actuellement ».",
            "C : Signifie « peut-être »."
          ],
          "example": "I am currently busy."
        },
        "en": {
          "rule": "currently = at present.",
          "why_wrong": [
            "A: Means 'in the end'.",
            "B: Means 'in fact', not 'at present'.",
            "C: Means 'perhaps'."
          ],
          "example": "I am currently busy."
        }
      },
      "vocab": []
    },
    {
      "id": "lq-vocab-false-friends-02",
      "part": 5,
      "difficulty": 2,
      "category": "voc-general",
      "stem": "After several revisions, the board ___ approved the plan.",
      "choices": [
        "sensibly",
        "possibly",
        "currently",
        "eventually"
      ],
      "correct": 3,
      "explanation": {
        "fr": {
          "rule": "eventually = finalement, à terme.",
          "why_wrong": [
            "A : Signifie « raisonnablement ».",
            "B : Signifie « peut-être ».",
            "C : Signifie « actuellement » : ne va pas avec un passé narratif."
          ],
          "example": "He eventually left."
        },
        "en": {
          "rule": "eventually = in the end.",
          "why_wrong": [
            "A: Means 'reasonably'.",
            "B: Means 'perhaps'.",
            "C: Means 'at present': does not fit a past narrative."
          ],
          "example": "He eventually left."
        }
      },
      "vocab": []
    },
