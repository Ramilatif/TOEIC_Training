        "en": {
          "rule": "attend = be present at (no preposition).",
          "why_wrong": [
            "A: Incorrect construction.",
            "C: 'participated in' would be needed.",
            "D: 'assist' = help, not be present at."
          ],
          "example": "She attended the class."
        }
      },
