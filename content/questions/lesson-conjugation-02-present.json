      "difficulty": 1,
      "category": "gram-verb-tenses",
      "stem": "Our accountant ___ the tax forms every March.",
      "choices": [
        "prepare",
        "prepares",
        "is preparing",
        "preparing"
      ],
      "correct": 1,
      "explanation": {
        "fr": {
          "rule": "Habitude → présent simple (-s à la 3e personne).",
          "why_wrong": [
            "A : 3e personne du singulier : -s obligatoire.",
            "C : « every March » exprime une habitude : présent simple.",
            "D : Il manque l'auxiliaire."
          ],
          "example": "She prepares reports."
        },
        "en": {
          "rule": "Habit → simple present (-s in the third person).",
          "why_wrong": [
            "A: Third person singular: -s is required.",
            "C: 'every March' expresses a habit: simple present.",
            "D: The auxiliary is missing."
          ],
          "example": "She prepares reports."
        }
      },
      "vocab": []
    },
