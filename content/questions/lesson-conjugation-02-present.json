        "en": {
          "rule": "State verbs: never continuous.",
          "why_wrong": [
            "A: 'understand' is a state verb: no continuous form.",
            "B: The negative needs 'do'.",
            "D: Subject 'we': 'do not'."
          ],
          "example": "I know the answer."
