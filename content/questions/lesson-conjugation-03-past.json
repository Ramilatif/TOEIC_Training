    {
      "id": "lq-conjugation-03-past-01",
      "part": 5,
      "difficulty": 1,
      "category": "gram-verb-tenses",
      "stem": "The shipment ___ two days ago.",
      "choices": [
        "has arrived",
        "arrives",
        "arrived",
        "was arriving"
      ],
      "correct": 2,
      "explanation": {
        "fr": {
          "rule": "ago / yesterday → prétérit.",
          "why_wrong": [
            "A : « ago » interdit le present perfect.",
            "B : Présent : le sens est passé.",
            "D : Le continu ne convient pas à une arrivée datée."
          ],
          "example": "He left two days ago."
        },
        "en": {
          "rule": "ago / yesterday → simple past.",
          "why_wrong": [
            "A: 'ago' rules out the present perfect.",
            "B: Present: the meaning is past.",
            "D: The continuous does not fit a dated arrival."
          ],
          "example": "He left two days ago."
        }
      },
      "vocab": []
    },
