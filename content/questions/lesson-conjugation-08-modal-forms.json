    {
      "id": "lq-conjugation-08-modal-forms-07",
      "part": 5,
      "difficulty": 3,
      "category": "gram-modals",
      "stem": "The lights are off; the staff ___ have left already.",
      "choices": [
        "should",
        "shall",
        "must",
        "would"
      ],
      "correct": 2,
      "explanation": {
        "fr": {
          "rule": "must have + p.p. = déduction quasi certaine.",
          "why_wrong": [
            "A : « should have » = reproche, pas déduction.",
            "B : « shall have » n'exprime pas la déduction.",
            "D : « would have » = irréel du passé."
          ],
          "example": "He must have left."
        },
        "en": {
          "rule": "must have + p.p. = almost certain deduction.",
          "why_wrong": [
            "A: 'should have' = criticism, not deduction.",
            "B: 'shall have' does not express deduction.",
            "D: 'would have' = unreal past."
          ],
          "example": "He must have left."
        }
      },
      "vocab": []
    },
