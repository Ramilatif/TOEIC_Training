  "questions": [
    {
      "id": "lq-conjugation-08-modal-forms-01",
      "part": 5,
      "difficulty": 2,
      "category": "gram-modals",
      "stem": "Employees ___ park in the visitors' lot; it is reserved.",
      "choices": [
        "cannot to",
        "may to",
        "must not",
        "do not have to"
      ],
      "correct": 2,
      "explanation": {
        "fr": {
          "rule": "must not = interdiction.",
          "why_wrong": [
            "A : Pas de « to » après un modal.",
            "B : Pas de « to » après un modal.",
            "D : Pas obligé ≠ interdit."
          ],
          "example": "You must not smoke."
        },
        "en": {
          "rule": "must not = prohibition.",
          "why_wrong": [
            "A: No 'to' after a modal.",
            "B: No 'to' after a modal.",
            "D: Not required ≠ forbidden."
          ],
          "example": "You must not smoke."
        }
      },
      "vocab": []
    },
    {
      "id": "lq-conjugation-08-modal-forms-02",
      "part": 5,
      "difficulty": 1,
      "category": "gram-modals",
      "stem": "She ___ speak three languages.",
      "choices": [
        "does can",
        "can to",
        "cans",
        "can"
      ],
      "correct": 3,
      "explanation": {
        "fr": {
          "rule": "Modal + base verbale, sans -s.",
          "why_wrong": [
            "A : Pas de « do » avec un modal.",
            "B : Pas de « to » après un modal.",
            "C : Pas de -s aux modaux."
          ],
          "example": "He can swim."
        },
        "en": {
          "rule": "Modal + base form, no -s.",
          "why_wrong": [
            "A: No 'do' with a modal.",
            "B: No 'to' after a modal.",
            "C: No -s with modals."
          ],
          "example": "He can swim."
        }
      },
      "vocab": []
    },
    {
      "id": "lq-conjugation-08-modal-forms-03",
      "part": 5,
      "difficulty": 2,
      "category": "gram-modals",
      "stem": "The shipment is late. The truck ___ have broken down.",
      "choices": [
        "will to",
        "can to",
        "might",
        "must to"
      ],
      "correct": 2,
      "explanation": {
        "fr": {
          "rule": "might have + participe = peut-être.",
          "why_wrong": [
            "A : Pas de « to » après un modal.",
            "B : Pas de « to » après un modal.",
            "D : Pas de « to » après un modal."
          ],
          "example": "He might have forgotten."
        },
        "en": {
          "rule": "might have + participle = maybe.",
          "why_wrong": [
            "A: No 'to' after a modal.",
            "B: No 'to' after a modal.",
            "D: No 'to' after a modal."
          ],
          "example": "He might have forgotten."
        }
      },
      "vocab": []
    },
    {
      "id": "lq-conjugation-08-modal-forms-04",
      "part": 5,
      "difficulty": 3,
      "category": "gram-modals",
      "stem": "You ___ the form before you left; now we have to start again.",
      "choices": [
        "should had completed",
        "should have completed",
        "must complete",
        "should complete"
      ],
      "correct": 1,
      "explanation": {
        "fr": {
          "rule": "should have + p.p. = reproche.",
          "why_wrong": [
            "A : « should » est suivi de « have », pas « had ».",
            "C : Obligation présente : mauvais sens.",
            "D : Reproche sur le passé : should have + participe."
          ],
          "example": "You should have called."
        },
        "en": {
          "rule": "should have + p.p. = criticism.",
          "why_wrong": [
            "A: 'should' is followed by 'have', not 'had'.",
            "C: Present obligation: wrong meaning.",
            "D: Criticism about the past: should have + participle."
          ],
          "example": "You should have called."
        }
      },
      "vocab": []
    },
    {
