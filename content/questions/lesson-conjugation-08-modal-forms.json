    {
      "id": "lq-conjugation-08-modal-forms-06",
      "part": 5,
      "difficulty": 1,
      "category": "gram-modals",
      "stem": "___ I use your phone, please?",
      "choices": [
        "Do",
        "May",
        "Am",
        "Will to"
      ],
      "correct": 1,
      "explanation": {
        "fr": {
          "rule": "May I ...? = demande de permission polie.",
          "why_wrong": [
            "A : « do » ne s'emploie pas avec un modal.",
            "C : « am » + base verbale est impossible.",
            "D : Pas de « to » après un modal."
          ],
          "example": "May I sit here?"
        },
        "en": {
          "rule": "May I ...? = polite request for permission.",
          "why_wrong": [
            "A: 'do' is not used with a modal.",
            "C: 'am' + base verb is impossible.",
            "D: No 'to' after a modal."
          ],
          "example": "May I sit here?"
        }
      },
