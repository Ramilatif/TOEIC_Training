      "id": "lq-advanced-10-agreement-determiners-01",
      "part": 5,
      "difficulty": 2,
      "category": "gram-quantifiers",
      "stem": "The number of applicants for the position ___ risen sharply this year.",
      "choices": [
        "were",
        "have",
        "has",
        "are"
      ],
      "correct": 2,
      "explanation": {
        "fr": {
          "rule": "The number of + pluriel → verbe singulier.",
          "why_wrong": [
            "A : Pluriel et passé : incorrect.",
            "B : « The number of » : accord singulier.",
            "D : « are » ne convient pas avec « risen »."
          ],
          "example": "The number of errors is low."
        },
        "en": {
          "rule": "The number of + plural → singular verb.",
          "why_wrong": [
            "A: Plural and past: incorrect.",
            "B: 'The number of': singular agreement.",
            "D: 'are' does not fit 'risen'."
          ],
          "example": "The number of errors is low."
        }
      },
      "vocab": []
    },
