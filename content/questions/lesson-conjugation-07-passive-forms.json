    {
      "id": "lq-conjugation-07-passive-forms-05",
      "part": 5,
      "difficulty": 3,
      "category": "gram-passive-voice",
      "stem": "By next Friday, the building ___ completely renovated.",
      "choices": [
        "has been",
        "was",
        "will be",
        "will have been"
      ],
      "correct": 3,
      "explanation": {
        "fr": {
          "rule": "Futur antérieur passif : will have been + participe.",
          "why_wrong": [
            "A : Présent parfait : le sens est futur.",
            "B : Prétérit : le sens est futur.",
            "C : Pour une action achevée avant un moment futur : futur antérieur."
          ],
          "example": "It will have been finished."
        },
        "en": {
          "rule": "Future perfect passive: will have been + participle.",
          "why_wrong": [
            "A: Present perfect: the meaning is future.",
            "B: Simple past: the meaning is future.",
            "C: For an action completed before a future moment: future perfect."
          ],
          "example": "It will have been finished."
        }
      },
      "vocab": []
    },
