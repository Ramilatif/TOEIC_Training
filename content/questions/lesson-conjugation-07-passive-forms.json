        "have painted"
      ],
      "correct": 0,
      "explanation": {
        "fr": {
          "rule": "Présent continu passif : am/is/are being + participe.",
          "why_wrong": [
            "B : Actif futur : mauvais sens.",
            "C : « at the moment » demande un passif progressif.",
            "D : Actif : mauvais sens."
          ],
          "example": "The road is being repaired."
        },
        "en": {
          "rule": "Present continuous passive: am/is/are being + participle.",
          "why_wrong": [
            "B: Active future: wrong meaning.",
            "C: 'at the moment' needs a progressive passive.",
            "D: Active: wrong meaning."
          ],
          "example": "The road is being repaired."
        }
      },
      "vocab": []
    },
    {
      "id": "lq-conjugation-07-passive-forms-03",
      "part": 5,
      "difficulty": 2,
      "category": "gram-passive-voice",
      "stem": "The order ___ already ___ shipped.",
      "choices": [
        "was / be",
        "has / being",
        "is / been",
        "has / been"
      ],
      "correct": 3,
      "explanation": {
        "fr": {
          "rule": "Present perfect passif : has/have been + participe.",
          "why_wrong": [
            "A : « was » exige un participe, pas « be ».",
            "B : « has » exige « been ».",
            "C : « is » + « been » est impossible."
          ],
          "example": "It has been done."
        },
        "en": {
          "rule": "Present perfect passive: has/have been + participle.",
          "why_wrong": [
            "A: 'was' requires a participle, not 'be'.",
            "B: 'has' requires 'been'.",
            "C: 'is' + 'been' is impossible."
          ],
          "example": "It has been done."
        }
      },
      "vocab": []
    },
    {
