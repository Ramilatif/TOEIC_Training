    {
      "id": "lq-conjugation-07-passive-forms-01",
      "part": 5,
      "difficulty": 1,
      "category": "gram-passive-voice",
      "stem": "The new regulations ___ by the board last week.",
      "choices": [
        "were approved",
        "have approved",
        "are approving",
        "approved"
      ],
      "correct": 0,
      "explanation": {
        "fr": {
          "rule": "Prétérit passif : was/were + participe.",
          "why_wrong": [
            "B : Actif : les règles ne peuvent pas approuver.",
            "C : Actif progressif : mauvais sens.",
            "D : Il manque l'auxiliaire du passif."
          ],
          "example": "It was sent."
        },
        "en": {
          "rule": "Simple past passive: was/were + participle.",
          "why_wrong": [
            "B: Active: regulations cannot approve.",
            "C: Active progressive: wrong meaning.",
            "D: The passive auxiliary is missing."
          ],
          "example": "It was sent."
        }
      },
      "vocab": []
    },
    {
