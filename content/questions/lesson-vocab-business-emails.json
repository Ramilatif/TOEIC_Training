      "choices": [
        "attaching",
        "attached",
        "enclosed",
        "attachment"
      ],
      "correct": 1,
      "explanation": {
        "fr": {
          "rule": "attached = joint à un e-mail.",
          "why_wrong": [
            "A : Participe présent incorrect ici.",
            "C : S'emploie pour un courrier papier (dans l'enveloppe).",
            "D : Nom : un participe est attendu."
          ],
          "example": "See the attached file."
        },
        "en": {
          "rule": "attached = included with an email.",
          "why_wrong": [
            "A: Present participle incorrect here.",
            "C: Used for paper mail (inside the envelope).",
            "D: Noun: a participle is expected."
          ],
          "example": "See the attached file."
        }
      },
      "vocab": []
