    {
      "id": "lq-grammar-adverbs-01",
      "part": 5,
      "difficulty": 1,
      "category": "gram-word-forms",
      "stem": "The new employee has ___ adapted to the team.",
      "choices": [
        "quickness",
        "quickly",
        "quick",
        "quicker"
      ],
      "correct": 1,
      "explanation": {
        "fr": {
          "rule": "Adverbe devant un participe.",
          "why_wrong": [
            "A : Nom.",
            "C : Adjectif : un adverbe est attendu devant « adapted ».",
            "D : Comparatif : pas de « than »."
          ],
          "example": "He has already left."
        },
        "en": {
          "rule": "Adverb before a participle.",
          "why_wrong": [
            "A: Noun.",
            "C: Adjective: an adverb is expected before 'adapted'.",
            "D: Comparative: no 'than'."
          ],
          "example": "He has already left."
        }
      },
      "vocab": []
    },
    {
