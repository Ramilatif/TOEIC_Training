      "part": 5,
      "difficulty": 1,
      "category": "gram-word-forms",
      "stem": "The order has not been delivered ___.",
      "choices": [
        "already",
        "ever",
        "yet",
        "since"
      ],
      "correct": 2,
      "explanation": {
        "fr": {
          "rule": "yet = négation/question.",
          "why_wrong": [
            "A : « already » s'emploie dans une phrase affirmative.",
            "B : Mauvais sens.",
            "D : Préposition ou conjonction."
          ],
          "example": "Have you finished yet?"
        },
        "en": {
          "rule": "yet = negative/question.",
          "why_wrong": [
            "A: 'already' is used in affirmative sentences.",
            "B: Wrong meaning.",
            "D: Preposition or conjunction."
          ],
          "example": "Have you finished yet?"
        }
      },
      "vocab": []
