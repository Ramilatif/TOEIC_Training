    {
      "id": "lq-grammar-adverbs-03",
      "part": 5,
      "difficulty": 2,
      "category": "gram-word-forms",
      "stem": "Which sentence is correct?",
      "choices": [
        "She speaks Spanish fluently.",
        "She fluently speaks Spanish well.",
        "She speaks Spanish fluent.",
        "She speaks fluently Spanish."
      ],
      "correct": 0,
      "explanation": {
        "fr": {
          "rule": "Verbe + complément + adverbe.",
          "why_wrong": [
            "B : Deux adverbes redondants.",
            "C : Adjectif au lieu d'un adverbe.",
            "D : Pas d'adverbe entre le verbe et son complément."
          ],
          "example": "He drives carefully."
        },
        "en": {
          "rule": "Verb + object + adverb.",
          "why_wrong": [
            "B: Two redundant adverbs.",
            "C: Adjective instead of an adverb.",
            "D: No adverb between verb and object."
          ],
          "example": "He drives carefully."
        }
      },
      "vocab": []
    },
    {
